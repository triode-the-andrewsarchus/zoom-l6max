diff --git a/patches/knob-dialog/src/notification_hooks.rs b/patches/knob-dialog/src/notification_hooks.rs
index f2f8c09..268828b 100644
--- a/patches/knob-dialog/src/notification_hooks.rs
+++ b/patches/knob-dialog/src/notification_hooks.rs
@@ -3,0 +4,9 @@ use core::ptr::read_volatile as read;
+// The diagnostic dual-effect payload sends copied words, never a DSP pointer.
+#[cfg(dual_efx)]
+#[unsafe(no_mangle)]
+#[unsafe(link_section = ".text.inspector_notify_hook")]
+pub unsafe extern "C" fn inspector_notify_hook(id: u32, bits: u32) {
+    if crate::parameter_view::DisplaySnapshot::from_words(id, bits).is_some() {
+        unsafe { sync::publish(16 + id, bits) };
+    }
+}
diff --git a/patches/knob-dialog/src/payload.rs b/patches/knob-dialog/src/payload.rs
index 9c8438c..af40878 100644
--- a/patches/knob-dialog/src/payload.rs
+++ b/patches/knob-dialog/src/payload.rs
@@ -9,0 +10,3 @@ mod values;
+#[cfg(dual_efx)]
+#[path = "../../dual-efx/src/parameter_view.rs"]
+mod parameter_view;
@@ -164,0 +168,11 @@ unsafe fn present(mode: u32, raw: u32) {
+        #[cfg(dual_efx)]
+        let inspector = if mode >= 16 {
+            let Some(snapshot) = parameter_view::DisplaySnapshot::from_words(mode - 16, raw) else { return; };
+            Some(parameter_view::format_display(snapshot))
+        } else {
+            None
+        };
+        // The ordinary mixer formatter runs with a safe placeholder when an
+        // inspector event will replace its text below.
+        #[cfg(dual_efx)]
+        let (mode, raw) = if inspector.is_some() { (0, 0) } else { (mode, raw) };
@@ -181,0 +196,10 @@ unsafe fn present(mode: u32, raw: u32) {
+        #[cfg(dual_efx)]
+        let (title, value_text) = if let Some(formatted) = inspector {
+            let mut title = [0u16; 24];
+            let mut value = [0u16; 24];
+            text(&mut title, formatted.title.as_bytes());
+            text(&mut value, &formatted.value_str[..formatted.value_len]);
+            (title, value)
+        } else {
+            (title, value_text)
+        };
