+
+// Disposable dual-effect diagnostic: producer tags edits with this generation.
+#[cfg(dual_efx)]
+pub unsafe fn inspector_generation() -> u32 {
+    unsafe {
+        let c = context();
+        if c.is_null() { return u32::MAX; }
+        enter();
+        let generation = read(core::ptr::addr_of!((*c).generation));
+        exit();
+        generation
+    }
+}
+
+// Compare and publish under the same critical section used by cancel().
+#[cfg(dual_efx)]
+pub unsafe fn publish_inspector(mode: u32, raw: u32, generation: u32) {
+    unsafe {
+        let c = context();
+        if c.is_null() { return; }
+        enter();
+        if read(core::ptr::addr_of!((*c).blocked)) == 0
+            && read(core::ptr::addr_of!((*c).generation)) == generation {
+            write(core::ptr::addr_of_mut!((*c).mode), mode);
+            write(core::ptr::addr_of_mut!((*c).raw), raw);
+            write(core::ptr::addr_of_mut!((*c).event_generation), generation);
+            write(core::ptr::addr_of_mut!((*c).pending), 1);
+        }
+        exit();
+    }
+}
+
+// Selector code can hold a stock semaphore: do not wait for the popup lock.
+#[cfg(dual_efx)]
+pub const INSPECTOR_CLOSE: u32 = u32::MAX - 1;
+#[cfg(dual_efx)]
+pub unsafe fn request_inspector_close() {
+    unsafe {
+        let c = context();
+        if c.is_null() { return; }
+        enter();
+        let generation = read(core::ptr::addr_of!((*c).generation)).wrapping_add(1);
+        write(core::ptr::addr_of_mut!((*c).generation), generation);
+        write(core::ptr::addr_of_mut!((*c).mode), INSPECTOR_CLOSE);
+        write(core::ptr::addr_of_mut!((*c).raw), 0);
+        write(core::ptr::addr_of_mut!((*c).event_generation), generation);
+        write(core::ptr::addr_of_mut!((*c).pending), 1);
+        exit();
+    }
+}
