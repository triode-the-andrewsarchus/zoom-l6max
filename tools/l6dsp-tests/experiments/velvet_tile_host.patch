+    fn tile_convolution_matches_reference_for_every_chunk_length_and_wrap() {
+        let mut bank = Bank::new();
+        bank.count = 400;
+        for i in 0..400 {
+            bank.storage[i] = Tap {
+                delay: ((i * 97) % 4801) as u32,
+                gain: ((i % 17) as f32 - 8.0) / 64.0,
+            };
+        }
+        let mut a = Box::new([0.0f32; HISTORY_SAMPLES]);
+        let mut b = Box::new([0.0f32; HISTORY_SAMPLES]);
+        for i in 0..HISTORY_SAMPLES {
+            a[i] = ((i * 31 % 103) as f32 - 51.0) / 128.0;
+            b[i] = ((i * 17 % 97) as f32 - 48.0) / 128.0;
+        }
+        for start in [
+            0,
+            1,
+            2,
+            3,
+            59,
+            4800,
+            HISTORY_SAMPLES - 4,
+            HISTORY_SAMPLES - 3,
+            HISTORY_SAMPLES - 2,
+            HISTORY_SAMPLES - 1,
+        ] {
+            for len in 0..=64 {
+                let mut actual = [[0.0f32; BLOCK]; 2];
+                block_convolve(&bank, &a, &b, start, len, &mut actual);
+                for i in 0..len {
+                    let mut expected = [0.0f32; 2];
+                    for tap in &bank.storage[..bank.count] {
+                        let read = (start + i + HISTORY_SAMPLES - tap.delay as usize) % HISTORY_SAMPLES;
+                        expected[0] += tap.gain * a[read];
+                        expected[1] += tap.gain * b[read];
+                    }
+                    for bus in 0..2 {
+                        assert_eq!(
+                            actual[bus][i].to_bits(),
+                            expected[bus].to_bits(),
+                            "start={start} len={len} sample={i} bus={bus}"
+                        );
+                    }
+                }
+            }
+        }
+    }
