+//! Disposable block scheduler experiment; not installable firmware.
+use super::*;
+const BLOCK: usize = 64;
+const MAX_FAST_DELAY: usize = 4800;
+
+fn fast_bank(bank: &Bank) -> bool {
+    bank.storage.get(..bank.count).is_some_and(|taps| taps.iter().all(|t| t.delay as usize <= MAX_FAST_DELAY))
+}
+
+fn block_convolve(bank: &Bank, a: &[f32; HISTORY_SAMPLES], b: &[f32; HISTORY_SAMPLES], start: usize, len: usize, out: &mut [[f32; BLOCK]; 2]) {
+    for tap in &bank.storage[..bank.count] {
+        let delay = tap.delay as usize;
+        let read = if start >= delay { start - delay } else { start + HISTORY_SAMPLES - delay };
+        let first = len.min(HISTORY_SAMPLES - read);
+        for (pos, dst, count) in [(read, 0, first), (0, first, len - first)] {
+            let (left, right) = out.split_at_mut(1);
+            for (((out_a, out_b), input_a), input_b) in left[0][dst..dst + count].iter_mut()
+                .zip(right[0][dst..dst + count].iter_mut())
+                .zip(&a[pos..pos + count]).zip(&b[pos..pos + count])
+            {
+                *out_a += tap.gain * *input_a;
+                *out_b += tap.gain * *input_b;
+            }
+        }
+    }
+}
+
+impl VelvetDecorrelator {
+    pub(crate) fn experimental_shared_block(&mut self, history: &mut MonoHistory, a: &[f32], b: &[f32], out: &mut [[f32; 4]]) {
+        let len = a.len();
+        assert!(len <= BLOCK && b.len() == len && out.len() == len);
+        let mut offset = 0;
+        while offset < len {
+            let aligned = self.valid_banks()
+                && self.channels[0].write_position == self.channels[1].write_position
+                && self.channels[0].write_position == history.write_position
+                && history.write_position < HISTORY_SAMPLES;
+            let valid = self.build.phase == 0 && aligned && (0..2).all(|c| fast_bank(&self.channels[c].banks[self.active_bank]))
+                && (!self.transitioning || (0..2).all(|c| fast_bank(&self.channels[c].banks[self.pending_bank])));
+            if !valid {
+                let ((al, ar), (bl, br)) = self.process_shared_mono(history, a[offset], b[offset]);
+                out[offset] = [al, ar, bl, br];
+                offset += 1;
+                continue;
+            }
+            let mut count = len - offset;
+            if self.transitioning {
+                count = count.min(self.active_transition_samples.saturating_sub(self.transition_position).max(1));
+            } else if self.filter_update_pending || (self.current.dynamic && self.samples_until_transition == 0) {
+                count = 1;
+            } else if self.current.dynamic {
+                count = count.min(self.samples_until_transition);
+            }
+            let start = history.write_position;
+            for i in offset..offset + count {
+                let input_a = audio_input(a[i]);
+                history.write(audio_input(b[i]));
+                history.advance();
+                for c in &mut self.channels {
+                    let wp = c.write_position;
+                    if c.delay_line[wp] != 0.0 { c.nonzero_samples -= 1; }
+                    if input_a != 0.0 { c.nonzero_samples += 1; }
+                    c.delay_line[wp] = input_a;
+                    c.write_position = if wp + 1 == HISTORY_SAMPLES { 0 } else { wp + 1 };
+                }
+            }
+            let sums = unsafe { &mut *(0x83e10000 as *mut [[[[f32; BLOCK]; 2]; 2]; 2]) };
+            unsafe { core::ptr::write_bytes(sums as *mut _, 0, 1); }
+            for c in 0..2 {
+                block_convolve(&self.channels[c].banks[self.active_bank], &self.channels[c].delay_line, &history.delay_line, start, count, &mut sums[0][c]);
+                if self.transitioning {
+                    block_convolve(&self.channels[c].banks[self.pending_bank], &self.channels[c].delay_line, &history.delay_line, start, count, &mut sums[1][c]);
+                }
+            }
+            for i in 0..count {
+                let amount = self.advance_amount();
+                let (old, new) = self.transition_weights();
+                for c in 0..2 {
+                    for bus in 0..2 {
+                        let mut wet = sums[0][c][bus][i];
+                        if self.transitioning { wet = old * wet + new * sums[1][c][bus][i]; }
+                        out[offset + i][bus * 2 + c] = soft_clip(wet * amount);
+                    }
+                }
+                self.advance_filter();
+            }
+            offset += count;
+        }
+    }
+}
