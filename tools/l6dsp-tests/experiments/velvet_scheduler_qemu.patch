+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn fallback_and_nonfinite_inputs_match_sample_path() {
+        for case in 0..4 {
+            let params=Parameters { dynamic: false, ..Parameters::default() };
+            let mut scalar=Box::new(VelvetDecorrelator::new());scalar.init(params);
+            let mut block=Box::new(VelvetDecorrelator::new());block.init(params);
+            let mut sh=Box::new(MonoHistory::new());let mut bh=Box::new(MonoHistory::new());
+            match case {
+                1 => { scalar.channels[1].write_position=20;block.channels[1].write_position=20; }
+                2 => { scalar.channels[0].banks[0].storage[0].delay=HISTORY_SAMPLES as u32+5;block.channels[0].banks[0].storage[0].delay=HISTORY_SAMPLES as u32+5; }
+                3 => { scalar.channels[0].banks[0].count=401;block.channels[0].banks[0].count=401; }
+                _ => {}
+            }
+            let mut a=[0.0f32;64];let mut b=a;
+            for i in 0..64 {a[i]=if i==7 {f32::NAN} else if i==9 {f32::INFINITY} else if i%3==0 {-0.0} else {i as f32/128.0};b[i]=-a[i];}
+            let mut actual=[[0.0f32;4];64];block.experimental_shared_block(&mut bh,&a,&b,&mut actual);
+            for i in 0..64 {let ((al,ar),(bl,br))=scalar.process_shared_mono(&mut sh,a[i],b[i]);let expected=[al,ar,bl,br];for j in 0..4 {assert_eq!(actual[i][j].to_bits(),expected[j].to_bits(),"case={case} frame={i} output={j}");}}
+        }
+    }
+    #[test]
+    fn block_matches_real_scheduler_across_edits_fades_and_wraps() {
+        let params = Parameters { length_ms: 100.0, density: 4000.0, refresh_seconds: 0.1, transition_ms: 90.0, ..Parameters::default() };
+        let mut scalar = Box::new(VelvetDecorrelator::new()); scalar.init(params);
+        let mut block = Box::new(VelvetDecorrelator::new()); block.init(params);
+        let mut sh = Box::new(MonoHistory::new()); let mut bh = Box::new(MonoHistory::new());
+        let mut position=0usize;
+        while position < 30000 {
+            if [0, 4979, 10031, 17003, 22001].contains(&position) {
+                let mut p=scalar.current;
+                p.amount=if position%2==0 {0.25} else {0.9};
+                p.decay_db=if position%2==0 {-36.0} else {-63.0};
+                p.transition_ms=if position%2==0 {30.0} else {90.0};
+                scalar.set_parameters(p); block.set_parameters(p);
+            }
+            let next=[4979,10031,17003,22001,30000].into_iter().find(|&x| x>position).unwrap();
+            let len=(next-position).min(64);
+            let mut a=[0.0f32;64];let mut b=a;
+            for i in 0..len { a[i]=(((position+i)*37%101) as f32-50.0)/200.0;b[i]=(((position+i)*71%103) as f32-51.0)/210.0; }
+            let mut actual=[[0.0f32;4];64];block.experimental_shared_block(&mut bh,&a[..len],&b[..len],&mut actual[..len]);
+            for i in 0..len {let ((al,ar),(bl,br))=scalar.process_shared_mono(&mut sh,a[i],b[i]);let expected=[al,ar,bl,br];for j in 0..4 {assert_eq!(actual[i][j].to_bits(),expected[j].to_bits(),"frame={} output={j}",position+i);}}
+            for c in 0..2 {
+                assert_eq!(block.channels[c].write_position, scalar.channels[c].write_position);
+                assert_eq!(block.channels[c].nonzero_samples, scalar.channels[c].nonzero_samples);
+                assert_eq!(block.channels[c].delay_line, scalar.channels[c].delay_line);
+                for bank in 0..2 {
+                    assert_eq!(block.channels[c].banks[bank].count, scalar.channels[c].banks[bank].count);
+                    for i in 0..400 {
+                        let x=block.channels[c].banks[bank].storage[i];let y=scalar.channels[c].banks[bank].storage[i];
+                        assert_eq!((x.delay,x.gain.to_bits()),(y.delay,y.gain.to_bits()));
+                    }
+                }
+            }
+            assert_eq!(bh.write_position,sh.write_position);assert_eq!(bh.nonzero_samples,sh.nonzero_samples);assert_eq!(bh.delay_line,sh.delay_line);
+            assert_eq!(block.amount_current.to_bits(),scalar.amount_current.to_bits());
+            assert_eq!(block.amount_remaining,scalar.amount_remaining);assert_eq!(block.samples_until_transition,scalar.samples_until_transition);
+            assert_eq!(block.filter_update_pending,scalar.filter_update_pending);
+            assert_eq!(block.active_bank,scalar.active_bank);assert_eq!(block.pending_bank,scalar.pending_bank);assert_eq!(block.transitioning,scalar.transitioning);assert_eq!(block.transition_position,scalar.transition_position);assert_eq!(block.build.phase,scalar.build.phase);assert_eq!(block.build.index,scalar.build.index);assert_eq!(block.generation,scalar.generation);
+            position+=len;
+        }
+    }
+}
